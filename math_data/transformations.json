{
  "meta": {
    "id": "math_data.transformations",
    "version": "0.1.0",
    "created": "2026-10-31",
    "description": "Декларативный школьный набор нормализационных тождеств и преобразований уравнений/неравенств.",
    "status": "registry-data; interpreter required",
    "language": "ru",
    "requires": "math_data/constraints.json",
    "default_number_domain": "R",
    "note": "The registry does not execute itself: Matchin needs a loader, AST pattern adapter, guard prover, and rewrite traversal."
  },
  "syntax": {
    "ast": "prefix arrays [operator, ...operands], metavariables start with $; exact integers ['int','n'], reduced rational ['rat','p','q']; no implicit floating-point evaluation",
    "binding": "All occurrences of the same metavariable match the same AST. Parameters not in lhs must be provided by the invoking operation.",
    "comparisons": "Guards use predicate ids from math_data/constraints.json. All listed guard predicates must be proven on the committed source domain.",
    "operators": [
      "add",
      "sub",
      "mul",
      "div",
      "neg",
      "pow",
      "sqrt",
      "root",
      "abs",
      "sin",
      "cos",
      "tan",
      "cot",
      "ln",
      "log",
      "exp",
      "factorial",
      "eq",
      "lt",
      "le",
      "gt",
      "ge"
    ],
    "rewriting": "lhs -> rhs only unless explicitly marked bidirectional. Generic assoc/comm rules live in normalization_strategies, never use unconstrained bidirectional rewrites."
  },
  "normalization_policy": {
    "starting_point": "Normalize candidate and reference on the original committed domain of their caret.",
    "graph": "Deduplicate equivalent AST states by stable canonical key plus committed assumptions; retain rule IDs as transition provenance.",
    "automatic_rules": "Only rules with mode=normalize and normalization_strategies; mode=manual_only is excluded from graph expansion.",
    "oriented_rewrites": "Run each automatic rewrite in the declared direction only; stop on a fixed point, repeated state, or explicit resource limit.",
    "conditions": "A rule may fire only when all guards are proved; on unknown, skip rule and retain unknown—not false.",
    "domain_provenance": "Preserve original-domain constraints even if a rewrite cancels a denominator or removes another restriction.",
    "outcomes": [
      "proved",
      "conditional",
      "rejected",
      "unknown"
    ],
    "limits": {
      "max_states": 512,
      "max_transitions": 2048,
      "max_depth": 40
    },
    "physical_rules": "Dimension compatibility is not identity. Physical laws may be connected as a separate authorized family under the same normalization graph."
  },
  "normalization_strategies": [
    {
      "id": "N001",
      "family": "structure",
      "handler": "flatten_associative",
      "operators": [
        "add",
        "mul"
      ],
      "description": "Flatten nested associative sums and products."
    },
    {
      "id": "N002",
      "family": "structure",
      "handler": "sort_commutative",
      "operators": [
        "add",
        "mul"
      ],
      "description": "Stable order of terms and factors avoids symmetric rewrite cycles."
    },
    {
      "id": "N003",
      "family": "arithmetic",
      "handler": "exact_rational",
      "description": "Combine exact integer, decimal and rational coefficients without floating-point rounding."
    },
    {
      "id": "N004",
      "family": "polynomial",
      "handler": "distribute_products",
      "description": "Expand polynomial products into common sum-of-monomials form."
    },
    {
      "id": "N005",
      "family": "polynomial",
      "handler": "collect_like_terms",
      "description": "Combine monomials with equal exponent maps."
    },
    {
      "id": "N006",
      "family": "rational",
      "handler": "normalize_rational",
      "description": "Bring rational expressions to a common exact numerator/denominator."
    },
    {
      "id": "N007",
      "family": "rational",
      "handler": "cancel_common_factor",
      "description": "Remove common factors only with original-domain nonzero provenance."
    },
    {
      "id": "N008",
      "family": "powers",
      "handler": "normalize_integer_powers",
      "description": "Handle exact integer powers subject to domain constraints."
    },
    {
      "id": "N009",
      "family": "relations",
      "handler": "normalize_relation",
      "description": "Compare supported equations/inequalities in a fixed relation representation; not a complete solution-set solver."
    }
  ],
