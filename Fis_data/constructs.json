{
  "schema_version": "0.9.3",
  "description": "elements: { E*: [ {id, overrides}, … ] } — instances grouped by component type. Recursive include[] → flatten. Defaults from components.json.",
  "meta": {
    "language_order": [
      "en",
      "ru"
    ],
    "id_prefix": "C",
    "components_ref": "components.json",
    "links_ref": "LINK.json",
    "notes": [
      "elements: { \"E001\": [ {id, overrides}, … ], \"E002\": […], … } — ключ = тип E*, значение = инстансы.",
      "overrides: { role: value } — только отличия от E*.default (components.json).",
      "links[].of — port_order; multi = elId | [elId…].",
      "include[] — рекурсивная сборка C* (как nested law).",
      "C001 atom; C002 parallel; C003 series; C010 = include C001."
    ]
  },
