{
  "schema_version": "4.1",
  "id": "AST",
  "description": "Однооператорные схемы + aliases. Без списка structures: дерево строится buildSchemeAst(scheme, arity).",
  "schemes": {
    "ratio": {
      "name": [
        "ratio",
        "отношение"
      ],
      "description": "O1 = O2 / O3",
      "fixed_arity": 2,
      "operand_count": 3
    },
    "product": {
      "name": [
        "product",
        "произведение"
      ],
      "description": "O1 = O2 · … · O_{n+1}",
      "min_arity": 2,
      "operand_count_from_arity": "arity+1"
    },
    "sum": {
      "name": [
        "sum",
        "сумма"
      ],
      "description": "O1 = O2 + … + O_{n+1}",
      "min_arity": 2,
      "operand_count_from_arity": "arity+1"
    },
    "reciprocal_sum": {
      "name": [
        "reciprocal_sum",
        "сумма обратных"
      ],
      "description": "1/O1 = 1/O2 + … + 1/O_{n+1}",
      "min_arity": 2,
      "operand_count_from_arity": "arity+1"
    },
    "unary_delta": {
      "name": [
        "delta",
        "приращение Δ"
      ],
      "description": "O1 = Δ(O2)",
      "fixed_arity": 1,
      "operand_count": 2,
      "unary": true,
      "op": "delta"
    },
    "unary_neg": {
      "name": [
        "negation",
        "отрицание"
      ],
      "description": "O1 = −(O2)",
      "fixed_arity": 1,
      "operand_count": 2,
      "unary": true,
      "op": "neg"
    },
    "unary_sin": {
      "name": [
        "sine",
        "синус"
      ],
      "description": "O1 = sin(O2)",
      "fixed_arity": 1,
      "operand_count": 2,
      "unary": true,
      "op": "sin"
    },
    "unary_cos": {
      "name": [
        "cosine",
        "косинус"
      ],
      "description": "O1 = cos(O2)",
      "fixed_arity": 1,
      "operand_count": 2,
      "unary": true,
      "op": "cos"
    },
    "unary_sqrt": {
      "name": [
        "square root",
        "квадратный корень"
      ],
      "description": "O1 = √(O2)",
      "fixed_arity": 1,
      "operand_count": 2,
      "unary": true,
      "op": "sqrt"
    },
    "unary_inv": {
      "name": [
        "reciprocal",
        "обратная величина"
      ],
      "description": "O1 = 1/(O2)",
      "fixed_arity": 1,
      "operand_count": 2,
      "unary": true,
      "op": "inv"
    },
    "square": {
      "name": [
        "square",
        "квадрат"
      ],
      "description": "O1 = O2²",
      "fixed_arity": 1,
      "operand_count": 2,
      "op": "pow",
      "exponent": 2
    },
    "power": {
      "name": [
        "power",
        "степень"
      ],
      "description": "O1 = O2 ^ O3  (показатель — num или величина)",
      "fixed_arity": 2,
      "operand_count": 3,
      "op": "pow"
    }
