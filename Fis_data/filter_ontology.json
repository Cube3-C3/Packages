{
  "meta": {
    "version": "0.2",
    "description": "Иерархическая онтология фильтрации. Корень — тип карточки (phys_quant | math_const | formulas); у каждой ветки свой набор criteria. Группы (collect=group) сворачивают несколько сырых значений в одну опцию списка.",
    "language_order": ["en", "ru"],
    "structure": "tree[card_type].filters[]"
  },
  "tree": [
    {
      "id": "phys_quant",
      "kind": "card_type",
      "label": ["Physical quantity", "Физическая величина"],
      "filters": [
        {
          "id": "domain",
          "label": ["Section", "Раздел"],
          "collect": "domains",
          "control": "select",
          "notes": "usages[].domains → domains.json"
        },
        {
          "id": "kind",
          "label": ["Kind", "Род"],
          "collect": "group",
          "control": "select",
          "notes": "Абстрактные роды: скаляр / вектор (вкл. псевдовектор) / комплексное",
          "options": [
            {
              "value": "scalar",
              "label": ["Scalar", "Скаляр"],
              "match": {
                "any": [
                  { "math_kind_in": ["scalar"] }
                ]
              }
            },
            {
              "value": "vector",
              "label": ["Vector", "Вектор"],
              "match": {
                "any": [
                  { "math_kind_in": ["vector", "pseudovector"] }
                ]
              }
            },
            {
              "value": "complex",
              "label": ["Complex", "Комплексное"],
              "match": {
                "any": [
                  { "math_kind_in": ["complex"] },
                  { "category_in": ["комплексное"] }
                ]
              }
            }
          ]
        },
        {
          "id": "category_bucket",
          "label": ["Category", "Категория"],
          "collect": "group",
          "control": "select",
          "notes": "Мини-группы по category: несколько формулировок вектора → один пункт «Вектор»",
          "options": [
            {
              "value": "scalar_family",
              "label": ["Scalar family", "Скаляр"],
              "match": {
                "any": [
                  {
                    "category_in": [
                      "скаляр",
                      "скаляр (безразмерный)",
                      "скаляр (счётный)",
                      "скаляр (иррациональное)",
                      "скаляр (трансцендентное)",
                      "скаляр / временна́я компонента 4-вектора"
                    ]
                  }
                ]
              }
            },
            {
              "value": "vector_family",
              "label": ["Vector family", "Вектор"],
              "match": {
                "any": [
                  {
                    "category_in": [
                      "вектор",
                      "вектор / компонента 4-вектора",
                      "вектор / псевдовектор"
                    ]
                  }
                ]
              }
            },
            {
              "value": "scalar_or_vector",
              "label": ["Scalar / vector", "Скаляр / вектор"],
              "match": {
                "any": [
                  { "category_in": ["скаляр / вектор"] }
                ]
              }
            },
            {
              "value": "complex_cat",
              "label": ["Complex", "Комплексное"],
              "match": {
                "any": [
                  { "category_in": ["комплексное"] }
                ]
              }
            }
          ]
        },
        {
          "id": "invariance",
          "label": ["Invariance", "Инвариантность"],
          "collect": "invariance",
          "control": "select",
          "notes": "quantity.invariance"
        },
        {
          "id": "unit_sys",
          "label": ["Unit system", "Система измерения"],
          "collect": "unit_sys",
          "control": "select",
          "static_options": [
            {
              "value": "SI",
              "label": ["SI (all dimensions)", "SI (все размерности)"]
            },
            {
              "value": "SI_named",
              "label": ["SI · named unit", "SI · именованная единица"]
            },
            {
              "value": "SI_comp",
              "label": ["SI · composition only", "SI · только композиция"]
            }
          ]
        }
      ]
    },
    {
      "id": "math_const",
      "kind": "card_type",
      "label": ["Mathematical number", "Математическое число"],
      "filters": [
        {
          "id": "domain",
          "label": ["Section", "Раздел"],
          "collect": "domains",
          "control": "select"
        },
        {
          "id": "number_kind",
          "label": ["Number kind", "Тип числа"],
          "collect": "group",
          "control": "select",
          "notes": "Свёртка category математических констант",
          "options": [
            {
              "value": "transcendental",
              "label": ["Transcendental", "Трансцендентное"],
              "match": {
                "any": [
                  { "category_contains": "трансцендент" }
                ]
              }
            },
            {
              "value": "irrational",
              "label": ["Irrational", "Иррациональное"],
              "match": {
                "any": [
                  { "category_contains": "иррациональ" }
                ]
              }
            },
            {
              "value": "complex_num",
              "label": ["Complex", "Комплексное"],
              "match": {
                "any": [
                  { "math_kind_in": ["complex"] },
                  { "category_in": ["комплексное"] }
                ]
              }
            },
            {
              "value": "scalar_num",
              "label": ["Scalar (other)", "Скаляр (прочее)"],
              "match": {
                "any": [
                  { "category_in": ["скаляр", "скаляр (безразмерный)", "скаляр (счётный)"] }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "formulas",
      "kind": "card_type",
      "label": ["Law / formula", "Формула (закон)"],
      "filters": [
        {
          "id": "structure",
          "label": ["Structure", "Структура"],
          "collect": "structure_ref",
          "control": "select",
          "notes": "law.structure_ref → AST structures"
        }
      ]
    }
  ]
}
