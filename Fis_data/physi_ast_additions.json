  "base_ref": "AST.json",
  "structures": [
    {"id":"A11","name":"product_equality","description":"O1 * O2 = O3 * O4","ast":{"op":"eq","lhs":{"op":"mul","args":[{"operand_id":"O1"},{"operand_id":"O2"}]},"rhs":{"op":"mul","args":[{"operand_id":"O3"},{"operand_id":"O4"}]}}},
