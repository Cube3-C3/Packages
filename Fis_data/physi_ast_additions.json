    {"id":"A13","name":"harmonic_sine","description":"O1 = O2 * sin(O3 * O4 + O5)","ast":{"op":"eq","lhs":{"operand_id":"O1"},"rhs":{"op":"mul","args":[{"operand_id":"O2"},{"op":"sin","arg":{"op":"add","args":[{"op":"mul","args":[{"operand_id":"O3"},{"operand_id":"O4"}]},{"operand_id":"O5"}]}}]}}},
    {"id":"A16","name":"product_cosine","description":"O1 = O2 * O3 * cos(O4)","ast":{"op":"eq","lhs":{"operand_id":"O1"},"rhs":{"op":"mul","args":[{"operand_id":"O2"},{"operand_id":"O3"},{"op":"cos","arg":{"operand_id":"O4"}}]}}},
    {"id":"A17","name":"negative_rate","description":"O1 = -delta(O2) / O3","ast":{"op":"eq","lhs":{"operand_id":"O1"},"rhs":{"op":"div","args":[{"op":"neg","arg":{"op":"delta","arg":{"operand_id":"O2"}}},{"operand_id":"O3"}]}}},
    {"id":"A18","name":"reciprocal_sum","description":"1/O1 = 1/O2 + 1/O3","ast":{"op":"eq","lhs":{"op":"div","args":[{"num":1},{"operand_id":"O1"}]},"rhs":{"op":"add","args":[{"op":"div","args":[{"num":1},{"operand_id":"O2"}]},{"op":"div","args":[{"num":1},{"operand_id":"O3"}]}]}}},
    {"id":"A20","name":"product_sine_equality","description":"O1 * sin(O2) = O3 * sin(O4)","ast":{"op":"eq","lhs":{"op":"mul","args":[{"operand_id":"O1"},{"op":"sin","arg":{"operand_id":"O2"}}]},"rhs":{"op":"mul","args":[{"operand_id":"O3"},{"op":"sin","arg":{"operand_id":"O4"}}]}}},
    {"id":"A23","name":"coefficient_product","description":"O1 = O2 * O3 * O4 / O5","ast":{"op":"eq","lhs":{"operand_id":"O1"},"rhs":{"op":"div","args":[{"op":"mul","args":[{"operand_id":"O2"},{"operand_id":"O3"},{"operand_id":"O4"}]},{"operand_id":"O5"}]}}},
    {"id":"A24","name":"sine_product_equals_product","description":"O1 * sin(O2) = O3 * O4","ast":{"op":"eq","lhs":{"op":"mul","args":[{"operand_id":"O1"},{"op":"sin","arg":{"operand_id":"O2"}}]},"rhs":{"op":"mul","args":[{"operand_id":"O3"},{"operand_id":"O4"}]}}},
    {"id":"A25","name":"odd_multiplier_product","description":"O1 = ((2 * O2) + 1) * O3 / 2","ast":{"op":"eq","lhs":{"operand_id":"O1"},"rhs":{"op":"div","args":[{"op":"mul","args":[{"op":"add","args":[{"op":"mul","args":[{"num":2},{"operand_id":"O2"}]},{"num":1}]},{"operand_id":"O3"}]},{"num":2}]}}},
    {"id":"A26","name":"gas_equation_form","description":"O1 * O2 = (O3 / O4) * O5 * O6","ast":{"op":"eq","lhs":{"op":"mul","args":[{"operand_id":"O1"},{"operand_id":"O2"}]},"rhs":{"op":"mul","args":[{"op":"div","args":[{"operand_id":"O3"},{"operand_id":"O4"}]},{"operand_id":"O5"},{"operand_id":"O6"}]}}}
