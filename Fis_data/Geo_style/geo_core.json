{
  "meta": {
    "version": "0.1",
    "description": "Ядро вычислимой геометрии. Сорты (Point, Vec2, Length, Angle…) и конструкторы фигур. Фигуры не хранятся как готовые объекты — они вычисляются из величин и операций (см. geo_ops.json). Размерность 0D–2D; 3D — задел.",
    "created": "2026-08-18",
    "language_order": ["en", "ru"],
    "related": ["geo_ops.json"],
    "notes": "Примитивы = именованные конструкторы над сортами. Хранение «готовой» геометрии минимизировано: выражение → проекция (SVG/Canvas/DOM)."
  },

  "sorts": {
    "Point": {
      "dim": 0,
      "name": ["Point", "Точка"],
      "math_kind": "vector",
      "notes": "Позиция в аффинном пространстве. В 2D обычно (x, y)."
    },
    "Vec2": {
      "dim": 1,
      "name": ["Vector 2D", "Вектор 2D"],
      "math_kind": "vector",
      "notes": "Направленный отрезок. Имеет длину и направление."
    },
    "Length": {
      "dim": 1,
      "name": ["Length", "Длина"],
      "math_kind": "scalar",
      "dimension": "[L]",
      "notes": "Метрическая величина. Основа масштаба."
    },
    "Angle": {
      "dim": 0,
      "name": ["Angle", "Угол"],
      "math_kind": "scalar",
      "dimension": "1",
      "notes": "Ориентация / поворот. Безразмерная (радианы как канон, градусы — отображение)."
    },
    "Scalar": {
      "dim": 0,
      "name": ["Scalar", "Скаляр"],
      "math_kind": "scalar",
      "notes": "Число без геометрической интерпретации (коэффициент, параметр t)."
    },
    "Path2": {
      "dim": 1,
      "name": ["Path 2D", "Путь 2D"],
      "math_kind": "vector",
      "notes": "Параметризованная кривая или ломаная. Результат композиций."
    },
    "Shape2": {
      "dim": 2,
      "name": ["Shape 2D", "Фигура 2D"],
      "math_kind": "scalar",
      "notes": "Замкнутая или заполняемая 2D-область (результат конструкторов)."
    }
  },

  "constructors": {
    "point": {
      "id": "G0.point",
      "dim": 0,
      "name": ["Point", "Точка"],
      "result_sort": "Point",
      "params": [
        { "name": "x", "sort": "Scalar", "role": "coord" },
        { "name": "y", "sort": "Scalar", "role": "coord" }
      ],
      "notes": "Атомарная точка из координат. Альтернатива: origin + Vec2."
    },
    "vec": {
      "id": "G1.vec",
      "dim": 1,
      "name": ["Vector", "Вектор"],
      "result_sort": "Vec2",
      "params": [
        { "name": "dx", "sort": "Scalar", "role": "component" },
        { "name": "dy", "sort": "Scalar", "role": "component" }
      ],
      "notes": "Вектор из компонентов. Или: from Point A to Point B."
    },
    "segment": {
      "id": "G1.segment",
      "dim": 1,
      "name": ["Segment", "Отрезок"],
      "result_sort": "Path2",
      "params": [
        { "name": "a", "sort": "Point", "role": "start" },
        { "name": "b", "sort": "Point", "role": "end" }
      ],
      "equivalent": "point + vec(b - a)",
      "notes": "Простейший 1D-примитив. Длина = |b - a|."
    },
    "ray": {
      "id": "G1.ray",
      "dim": 1,
      "name": ["Ray", "Луч"],
      "result_sort": "Path2",
      "params": [
        { "name": "origin", "sort": "Point", "role": "start" },
        { "name": "direction", "sort": "Vec2", "role": "dir" }
      ],
      "notes": "Начало + направление. Полубесконечный."
    },
    "polyline": {
      "id": "G1.polyline",
      "dim": 1,
      "name": ["Polyline", "Ломаная"],
      "result_sort": "Path2",
      "params": [
        { "name": "points", "sort": "Point", "role": "vertices", "variadic": true }
      ],
      "notes": "Последовательность точек, соединённых отрезками."
    },
    "circle": {
      "id": "G2.circle",
      "dim": 2,
      "name": ["Circle", "Окружность / круг"],
      "result_sort": "Shape2",
      "params": [
        { "name": "center", "sort": "Point", "role": "center" },
        { "name": "radius", "sort": "Length", "role": "size" }
      ],
      "notes": "Центр + радиус. Замкнутая кривая или диск — решает стиль (fill/stroke)."
    },
    "rect": {
      "id": "G2.rect",
      "dim": 2,
      "name": ["Rectangle", "Прямоугольник"],
      "result_sort": "Shape2",
      "params": [
        { "name": "origin", "sort": "Point", "role": "origin" },
        { "name": "width", "sort": "Length", "role": "size" },
        { "name": "height", "sort": "Length", "role": "size" },
        { "name": "rotation", "sort": "Angle", "role": "orient", "optional": true }
      ],
      "equivalent": "origin + rotate(vec(width,0), φ) + rotate(vec(0,height), φ)",
      "notes": "Точка + два размера + опциональный угол. Не обязательно axis-aligned."
    },
    "ellipse": {
      "id": "G2.ellipse",
      "dim": 2,
      "name": ["Ellipse", "Эллипс"],
      "result_sort": "Shape2",
      "params": [
        { "name": "center", "sort": "Point", "role": "center" },
        { "name": "rx", "sort": "Length", "role": "size" },
        { "name": "ry", "sort": "Length", "role": "size" },
        { "name": "rotation", "sort": "Angle", "role": "orient", "optional": true }
      ],
      "notes": "Обобщение круга. rx/ry — полуоси."
    },
    "regular_polygon": {
      "id": "G2.regular_polygon",
      "dim": 2,
      "name": ["Regular polygon", "Правильный многоугольник"],
      "result_sort": "Shape2",
      "params": [
        { "name": "center", "sort": "Point", "role": "center" },
        { "name": "radius", "sort": "Length", "role": "size" },
        { "name": "n", "sort": "Scalar", "role": "count" },
        { "name": "rotation", "sort": "Angle", "role": "orient", "optional": true }
      ],
      "notes": "n ≥ 3. Вершины = center + rotate(vec(radius,0), φ0 + 2πk/n)."
    },
    "polygon": {
      "id": "G2.polygon",
      "dim": 2,
      "name": ["Polygon", "Многоугольник"],
      "result_sort": "Shape2",
      "params": [
        { "name": "points", "sort": "Point", "role": "vertices", "variadic": true }
      ],
      "notes": "Замкнутая ломаная. Ориентация (CW/CCW) влияет на fill."
    }
  },

  "dim_groups": {
    "0D": ["Point"],
    "1D": ["Vec2", "Path2", "Length"],
    "2D": ["Shape2"],
    "scalar": ["Angle", "Scalar"]
  }
}
