{
  "meta": {
    "schema_version": "0.3.0",
    "package": "PDD.meta",
    "title": "Executable metadata contracts for PDD ontology",
    "type": "executable_domain_contract"
  },
  "principle": "PDD entities are identified in the normative ontology. Rules reference entity IDs; executable contracts transform facts and conditions into binary relations and state transitions.",
  "entity_reference": {
    "source": "PDD.json#/ontology",
    "required": true,
    "rule_reference": "PDD.json#/rules"
  },
  "fact_model": {
    "subject": "entity:*",
    "predicate": "relation:*",
    "object": "entity:*",
    "examples": [
      ["participant:A", "pdd.relation.travels_on", "pdd.road.segment:A"],
      ["pdd.road:A", "pdd.relation.intersects", "pdd.road:B"],
      ["pdd.control.sign:A", "pdd.relation.applies_to", "pdd.movement:A"],
      ["participant:A", "pdd.relation.conflicts_with", "participant:B"]
    ]
  },
  "rule_contract": {
    "id": "pdd.rule.*",
    "reference": "PDD.json#/rules/*",
    "inputs": ["entities", "facts", "conditions", "state"],
    "operation": "resolve",
    "output": {
      "type": "binary_relation",
      "subject": "entity:*",
      "object": "entity:*",
      "relation": "relation:*",
      "basis": "pdd.rule.*",
      "status": "applicable|not_applicable|satisfied|violated"
    }
  },
  "control_resolution": {
    "description": "Select the strongest active control source before evaluating default intersection relations.",
    "precedence": [
      "pdd.control.traffic_controller",
      "pdd.control.traffic_light",
      "pdd.control.sign",
      "pdd.control.marking",
      "pdd.road.priority.main",
      "pdd.road.priority.secondary",
      "pdd.road.surface.paved",
      "pdd.road.surface.unpaved",
      "default"
    ],
    "operation": "first_applicable"
  },
  "binary_relation_resolution": {
    "description": "For a conflict between two equal-rank participants, resolve only the relation between the pair.",
    "input": ["participant:A", "participant:B"],
    "preconditions": [
      "A conflicts with B",
      "A and B are in the same applicable control regime"
    ],
    "outputs": [
      "pdd.relation.has_priority_over",
      "pdd.relation.must_yield_to",
      "pdd.relation.permits",
      "pdd.relation.restricts"
    ]
  },
  "state_transition": {
    "input": "user_action",
    "operation": "apply",
    "output": "next_state",
    "violation": {
      "rule": "pdd.rule.*",
      "relation": "relation:*",
      "explanation": "rule reference + evaluated relation"
    }
  }
}
